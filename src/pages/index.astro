---
import Layout from '../layouts/Layout.astro';
import liroYt from '../assets/images/liro-yt.jpg';
import vrcGroup from '../assets/images/vrc-group-picture.png';
import tiktok from '../assets/images/tiktok.webp';
import youtube from '../assets/images/youtube.webp';
import vodBild from '../assets/images/vod-bild.png';
import twitch from '../assets/images/twitch.webp';
import discord from '../assets/images/discord.webp';
import insta from '../assets/images/insta.webp';
import kofisymbol from '../assets/images/kofisymbol.png';
import x from '../assets/images/x_logo.png';
import SocialCard from "../components/SocialCard.astro";
---

<Layout>
	<div class="home">

		<aside class="profile">
			<div class="avatar xl">
				<img
					src={liroYt.src}
					alt=""
					style="object-position:46% 14%;transform:scale(2.05);transform-origin:46% 14%"
				/>
			</div>
			<h1>WILLKOMMEN!!!!</h1>
			<p class="tagline">Content Creator/Furry</p>
			<div class="bio prose"><p>Hier gehts zu meinen Kanälen :3</p></div>
			<div class="home-frame">
				<img class="home-image" src={vrcGroup.src} alt="">
			</div>
		</aside>

		<section class="links" aria-label="Links">
			<div class="lgroup">
				<div class="lrows">

					<SocialCard
						platformName="TikTok"
						socialsLink="https://tiktok.com/@liro7160"
						platformLink="tiktok.com"
						color="rgb(38 38 48 / 0.78)"
						img={tiktok.src}
						scale="130%"
					/>

					<SocialCard
						platformName="YouTube"
						socialsLink="https://youtube.com/@liro_lol"
						platformLink="youtube.com"
						color="rgb(239 45 45 / 0.78)"
						img={youtube.src}
					/>

					<SocialCard
						platformName="Liro VODs"
						socialsLink="https://www.youtube.com/@LiroVODs"
						platformLink="youtube.com"
						color="rgb(255 98 0 / 0.78)"
						img={vodBild.src}
					/>

					<SocialCard
						platformName="Twitch"
						socialsLink="https://www.twitch.tv/lirooo0"
						platformLink="twitch.tv"
						color="rgb(133 38 189 / 0.78)"
						img={twitch.src}
					/>

					<SocialCard
						platformName="Discord"
						socialsLink="https://discord.gg/x8W23Xwmph"
						platformLink="discord.gg"
						color="rgb(18 59 156 / 0.78)"
						img={discord.src}
						scale="120%"
					/>

					<SocialCard
						platformName="Instagram"
						socialsLink="https://instagram.com/lirooo0"
						platformLink="instagram.com"
						color="rgb(255 40 129 / 0.79)"
						img={insta.src}
						scale="120%"
					/>

					<SocialCard
						platformName="Supporte Mich :3"
						socialsLink="https://ko-fi.com/lirostarcat"
						platformLink="ko-fi.com"
						color="rgb(102 50 189 / 0.78)"
						img={kofisymbol.src}
					/>

					<SocialCard
						platformName="X"
						socialsLink="https://x.com/Liroooo0"
						platformLink="x.com"
						color="rgb(0 0 0 / 0.78)"
						img={x.src}
						scale="60%"
					/>

				</div>
			</div>
		</section>
	</div>
</Layout>

<style>
	.home { max-width: 1200px; margin: 0 auto; text-align: center; padding: 0 1rem; }

	.profile { max-width: 480px; margin: 0 auto; display: flex; flex-direction: column; align-items: center; }

	.profile h1 { font-size: clamp(1.9rem, 7vw, 2.7rem); line-height: 1.1; margin: 26px 0 8px; overflow-wrap: anywhere; text-wrap: balance; }
	.tagline { margin: 0; color: var(--muted); font-size: 1.05rem; }
	.bio { max-width: 420px; margin: 16px auto 0; color: #b4b4bb; line-height: 1.65; }
	.bio.prose p:last-child { margin-bottom: 0; }
	.cta { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; margin-top: 22px; }
	.home-frame {
		width: fit-content; max-width: 100%; margin: 24px auto 0;
		overflow: hidden; border-radius: 12px; border: 1px solid var(--line);
	}
	.home-image { display: block; max-width: 100%; height: auto; }

	.links { margin-top: 48px; width: 100%; }
	.lgroup + .lgroup { margin-top: 44px; }
	.gl { margin: 0 0 20px; font-size: 1.45rem; font-weight: 700; letter-spacing: -.01em; color: var(--text); }

	.lrows { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1.5rem; }

	@media (max-width: 768px) {
		.lrows { grid-template-columns: repeat(2, minmax(0, 1fr)); }
	}

	.avatar {
		position: relative; display: grid; place-items: center; overflow: hidden;
		border-radius: 50%; background: var(--raised); color: var(--muted);
		border: 1px solid var(--line); font-weight: 700; flex: 0 0 auto;
	}
	.avatar > * { grid-area: 1 / 1; }
	.avatar img { width: 100%; height: 100%; object-fit: cover; background: var(--raised); }
	.avatar.md { width: 60px; height: 60px; font-size: 24px; }
	.avatar.xl { width: 128px; height: 128px; font-size: 48px; box-shadow: 0 0 0 4px var(--bg), 0 0 0 5px #4a4a52, 0 0 40px rgba(var(--glow), .16); }

</style>