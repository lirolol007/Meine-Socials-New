---
import Layout from "../layouts/Layout.astro";
import sethe from "../assets/images/sethe-pfp.png";
import ryio from "../assets/images/ryio-pfp.jpeg";
import miausor from "../assets/images/b61ee55910582592e759baf067487b9ftplv-tiktokx-cropcenter10801080.jpeg";
import lynxi from "../assets/images/lynxi-pfp.jpeg";
import chefmahlzeit from "../assets/images/chefmahlzeit-pfp.jpeg";
---

<Layout>
    <div class="wrapper">
        <header class="section-header">
            <h1>Freunde</h1>
        </header>

        <div class="friends-list">
            <article class="friend-item">
                <div class="friend-avatar">
                    <span>S</span>
                    <img src={sethe.src} alt="Sethe">
                </div>
                <div class="friend-content">
                    <div class="friend-top">
                        <h2>Sethe</h2>
                        <div class="links">
                            <a href="https://www.twitch.tv/sethevt" target="_blank" rel="noopener noreferrer">Twitch</a>
                            <span class="dot">·</span>
                            <a href="https://www.youtube.com/@Sethe_Galenea" target="_blank" rel="noopener noreferrer">Youtube</a>
                            <span class="dot">·</span>
                            <a href="https://www.tiktok.com/@sethegalenea" target="_blank" rel="noopener noreferrer">Tiktok</a>
                        </div>
                    </div>
                    <p>Ein Rentner Barde :3</p>
                </div>
            </article>

            <article class="friend-item">
                <div class="friend-avatar">
                    <span>R</span>
                    <img src={ryio.src} alt="Ryio">
                </div>
                <div class="friend-content">
                    <div class="friend-top">
                        <h2>Ryio</h2>
                        <div class="links">
                            <a href="https://www.tiktok.com/@fluffy_ryio" target="_blank" rel="noopener noreferrer">Tiktok</a>
                        </div>
                    </div>
                    <p>Einfach nen Kleiner Nova mit ner Hohen Stimme XD</p>
                </div>
            </article>

            <article class="friend-item">
                <div class="friend-avatar">
                    <span>M</span>
                    <img src={miausor.src} alt="Miausor">
                </div>
                <div class="friend-content">
                    <div class="friend-top">
                        <h2>Miausor</h2>
                        <div class="links">
                            <a href="https://www.tiktok.com/@miausor_?lang=de-DE" target="_blank" rel="noopener noreferrer">Tiktok</a>
                        </div>
                    </div>
                    <p>Noch eine Katze auf Tiktok :3</p>
                </div>
            </article>

            <article class="friend-item">
                <div class="friend-avatar">
                    <span>L</span>
                    <img src={lynxi.src} alt="Lynxi">
                </div>
                <div class="friend-content">
                    <div class="friend-top">
                        <h2>Lynxi</h2>
                        <div class="links">
                            <a href="https://www.tiktok.com/@lynxi.vrc?lang=de-DE" target="_blank" rel="noopener noreferrer">Tiktok</a>
                        </div>
                    </div>
                    <p>Eine weitere Katze auf Tiktok x3</p>
                </div>
            </article>

            <article class="friend-item">
                <div class="friend-avatar">
                    <span>C</span>
                    <img src={chefmahlzeit.src} alt="ChefMahlZeit">
                </div>
                <div class="friend-content">
                    <div class="friend-top">
                        <h2>ChefMahlZeit</h2>
                        <div class="links">
                            <a href="https://www.tiktok.com/@chefmahlzeit?lang=de-DE" target="_blank" rel="noopener noreferrer">Tiktok</a>
                        </div>
                    </div>
                    <p>Einer von 1Mio Novas X3</p>
                </div>
            </article>
        </div>
    </div>
</Layout>

<style>
    .wrapper {
        max-width: 720px;
        margin: 0 auto;
    }

    .section-header {
        margin-bottom: 40px;
    }

    .section-header h1 {
        font-size: 2.2rem;
        font-weight: 700;
        margin-bottom: 8px;
        letter-spacing: -0.02em;
    }

    .section-header p {
        color: var(--muted, #888);
        font-size: 1rem;
        margin: 0;
    }

    .friends-list {
        display: flex;
        flex-direction: column;
        gap: 16px;
    }

    .friend-item {
        display: flex;
        align-items: flex-start;
        gap: 18px;
        padding: 20px;
        background: linear-gradient(135deg, #000000 0%, #3a3a3a 100%);
        border: 1px solid var(--line, rgba(255, 255, 255, 0.08));
        border-radius: 12px;
        transition: border-color 0.15s ease, background 0.15s ease;
    }

    .friend-item:hover {
        border-color: var(--accent, #666);
        background: linear-gradient(135deg, #000000 0%, #676767 100%);
    }

    .friend-avatar {
        position: relative;
        width: 48px;
        height: 48px;
        border-radius: 50%;
        overflow: hidden;
        background: var(--line, #222);
        display: grid;
        place-items: center;
        font-size: 18px;
        font-weight: 600;
        color: var(--muted, #888);
        flex-shrink: 0;
    }

    .friend-avatar > * {
        grid-area: 1 / 1;
    }

    .friend-avatar img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .friend-content {
        flex: 1;
        min-width: 0;
    }

    .friend-top {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        justify-content: space-between;
        gap: 8px;
        margin-bottom: 4px;
    }

    .friend-top h2 {
        font-size: 1.05rem;
        font-weight: 600;
        margin: 0;
    }

    .links {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 0.85rem;
    }

    .links a {
        color: var(--muted, #aaa);
        text-decoration: none;
        transition: color 0.15s;
    }

    .links a:hover {
        color: var(--accent, #fff);
        text-decoration: underline;
    }

    .dot {
        color: var(--muted, #555);
        font-size: 0.75rem;
    }

    .friend-content p {
        margin: 0;
        color: #b4b4bb;
        font-size: 0.95rem;
        line-height: 1.4;
    }
</style>