---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Particles from "@tsparticles/astro";
import type { ISourceOptions } from "@tsparticles/engine";
import { ClientRouter } from "astro:transitions";
import favicon from '../assets/favicon.png';

const options: ISourceOptions = {
	fullScreen: {
		enable: true,
		zIndex: -1,
	},
	background: {
		color: {
			value: "transparent",
		},
	},
	fpsLimit: 120,
	interactivity: {
		events: {
			onClick: {
				enable: false,
			},
			onHover: {
				enable: false,
			},
		},
	},
	particles: {
		color: {
			value: ["#38bdf8", "#818cf8", "#c084fc", "#f43f5e", "#34d399", "#fde047"],
		},
		move: {
			direction: "none",
			enable: true,
			outModes: {
				default: "out",
			},
			random: true,
			speed: 1.5,
			straight: false,
		},
		number: {
			density: {
				enable: true,
			},
			value: 80,
		},
		opacity: {
			value: { min: 0.15, max: 0.6 },
			animation: {
				enable: true,
				speed: 0.8,
				sync: false,
			},
		},
		shape: {
			type: "circle",
		},
		size: {
			value: { min: 1.5, max: 4 },
		},
	},
	detectRetina: true,
};

---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/png" href={favicon.src} />
		<meta name="generator" content={Astro.generator} />
		<title>Liro</title>
	</head>
	<body>
	     <Header />
		<main class="content">
		    <slot />
		</main>
		<Footer />
		<script>
			import { initParticlesEngine } from "@tsparticles/astro";

			void initParticlesEngine(async (engine) => {
				const { loadFull } = await import("tsparticles");
				await loadFull(engine);

			});
		</script>

	</body>
</html>

<Particles id="tsparticles" options={options} />

<style is:global>
	[data-id="tsparticles"] {
		position: fixed
	}
</style>

<ClientRouter />
